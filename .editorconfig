root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xml,yml,yaml,json,md}]
indent_size = 2

# Markdown uses trailing spaces for line breaks
[*.md]
trim_trailing_whitespace = false

# Windows scripts keep CRLF
[*.{cmd,bat,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab